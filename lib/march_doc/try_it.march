-- TryIt — the "Try it" sidebar REPL for generated module pages.
--
-- With `--try-it`, Markdown marks runnable code blocks with data-try (the code)
-- and data-try-kind (transcript | program); see Markdown.md_to_html_mode. This
-- module emits, once per module page:
--   * the sidebar: a header (clear / reset / close), a transcript, an input row;
--   * its CSS (theme tokens from DocHtml.page_css, so both themes work);
--   * a script that adds a "Try it" button to every pre[data-try], and on the
--     first click loads <site_base>/assets/march-repl.js (the march-lang.org REPL
--     loader, which then loads the interpreter) and runs the example.
-- Nothing is fetched before that first click.
--
-- A transcript runs one `march>` expression per REPL input, so each result shows
-- under its expression as in the docs; a program runs as one input. Examples
-- share one session (definitions persist); the header's clear / reset manage it.
-- Requires march-repl.js with MarchRepl.prototype.run (march repo, 2026-10-14).

mod TryIt do

fn panel_css() : String do
  IOList.to_string(~H"""
/* Try it */
.try-btn{position:absolute;top:8px;right:70px;background:var(--card);color:var(--acc);border:1px solid var(--bdr);border-radius:5px;padding:3px 10px;font-size:11px;font-family:-apple-system,sans-serif;cursor:pointer;transition:all .15s;z-index:1}
.try-btn:hover{color:var(--bright);border-color:var(--acc)}
.pre-wrap.try-only .try-btn{right:10px}
/* march-repl.js colours input with the site's --syn-* tokens: map them to this page's highlight tokens */
#try-panel{--syn-kw:var(--hl-kw);--syn-tp:var(--hl-ty);--syn-st:var(--hl-str);--syn-nm:var(--hl-num);--syn-cm:var(--hl-com);--syn-id:var(--text);--syn-op:var(--dim)}
#try-panel{position:fixed;top:60px;right:0;bottom:0;width:440px;max-width:100vw;background:var(--sb);border-left:1px solid var(--bdr);display:none;flex-direction:column;z-index:90}
#try-panel.open{display:flex}
body.try-open .content-wrap{margin-right:440px}
.try-head{display:flex;align-items:center;gap:6px;padding:10px 14px;border-bottom:1px solid var(--bdr);flex-shrink:0}
.try-title{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--dim);letter-spacing:.04em}
.try-hbtn{background:none;border:1px solid var(--bdr);color:var(--dim);border-radius:4px;padding:2px 10px;font-size:11px;cursor:pointer;font-family:'JetBrains Mono',monospace}
.try-hbtn:hover{border-color:var(--acc);color:var(--text)}
#try-history{flex:1;overflow-y:auto;padding:12px 14px;font-family:'JetBrains Mono',monospace;font-size:12.5px;line-height:1.55}
.try-entry{white-space:pre-wrap;word-break:break-word}
.try-iline{color:var(--text);white-space:pre-wrap!important}.try-iline::before{content:'march> ';color:var(--dim)}
.try-out{color:var(--fn)}.try-err{color:oklch(68% .17 25)}.try-info{color:var(--dim);font-style:italic}
.try-input-row{display:flex;align-items:flex-start;gap:8px;padding:10px 14px;border-top:1px solid var(--bdr);flex-shrink:0}
.try-prompt{font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--dim);padding-top:3px}
#try-input{flex:1;background:transparent;border:none;outline:none;resize:none;color:var(--text);font-family:'JetBrains Mono',monospace;font-size:12.5px;line-height:1.55}
@media(max-width:900px){#try-panel{width:100vw}body.try-open .content-wrap{margin-right:0}}
""")
end

fn panel_js() : String do
  IOList.to_string(~H"""
(function(){
function init(){
var panel=document.getElementById('try-panel');if(!panel)return;
var base=panel.getAttribute('data-base')||'';
var repl=null,loading=false,waiting=[];
var status=document.getElementById('try-loading');
function open(){panel.classList.add('open');document.body.classList.add('try-open');}
function close(){panel.classList.remove('open');document.body.classList.remove('try-open');}
document.getElementById('try-close').addEventListener('click',close);
document.getElementById('try-clear').addEventListener('click',function(){if(repl)repl.clear();});
document.getElementById('try-reset').addEventListener('click',function(){if(repl)repl.reset();});
function withRepl(cb){
if(repl){cb();return;}
waiting.push(cb);if(loading)return;loading=true;
status.textContent='Loading the March REPL…';
var s=document.createElement('script');s.src=base+'/assets/march-repl.js';
s.onload=function(){
repl=new MarchRepl({wrapId:'try-panel',historyId:'try-history',inputId:'try-input',loadingId:'try-loading',
cls:{entry:'try-entry',inputLine:'try-iline',output:'try-out',error:'try-err',info:'try-info'}});
document.getElementById('try-run').addEventListener('click',function(){repl.submit();});
var w=waiting;waiting=[];w.forEach(function(f){f();});};
s.onerror=function(){loading=false;waiting=[];status.textContent='Could not load the March REPL.';};
document.head.appendChild(s);}
function run(pre){
open();
withRepl(function(){
var src=pre.getAttribute('data-try')||'';
if(pre.getAttribute('data-try-kind')==='transcript'){src.split(String.fromCharCode(10)).forEach(function(l){if(l.trim())repl.run(l);});}
else{repl.run(src);}});}
document.querySelectorAll('pre[data-try]').forEach(function(pre){
var wrap=pre.parentNode;
if(!wrap||!wrap.classList||!wrap.classList.contains('pre-wrap')){
wrap=document.createElement('div');wrap.className='pre-wrap try-only';
pre.parentNode.insertBefore(wrap,pre);wrap.appendChild(pre);}
var b=document.createElement('button');b.type='button';b.className='try-btn';
b.textContent='Try it';b.title='Run this example in the March REPL';
b.addEventListener('click',function(){run(pre);});
wrap.appendChild(b);});
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
""")
end

-- The sidebar, its CSS and its script. site_base is the site root the REPL
-- assets live under: "" for march-lang.org (/assets/march-repl.js).
fn panel(site_base : String) : String do
  "<style>" ++ panel_css() ++ "</style>" ++
  "<aside id=\"try-panel\" data-base=\"" ++ Markdown.html_escape(site_base) ++ "\" aria-label=\"March REPL\">" ++
  "<div class=\"try-head\"><span class=\"try-title\">march — try it</span>" ++
  "<button class=\"try-hbtn\" id=\"try-clear\" type=\"button\" title=\"Clear the screen; definitions stay (Ctrl+L)\">clear</button>" ++
  "<button class=\"try-hbtn\" id=\"try-reset\" type=\"button\" title=\"Clear the screen and forget every definition\">reset</button>" ++
  "<button class=\"try-hbtn\" id=\"try-close\" type=\"button\">close</button></div>" ++
  "<div id=\"try-history\"><div class=\"try-entry\"><span class=\"try-info\" id=\"try-loading\"></span></div></div>" ++
  "<div class=\"try-input-row\"><span class=\"try-prompt\">march&gt;</span>" ++
  "<textarea id=\"try-input\" rows=\"1\" placeholder=\"try something…\" autocomplete=\"off\" spellcheck=\"false\"></textarea>" ++
  "<button class=\"try-hbtn\" id=\"try-run\" type=\"button\">run</button></div>" ++
  "</aside>" ++
  "<script>" ++ panel_js() ++ "</script>"
end

end
